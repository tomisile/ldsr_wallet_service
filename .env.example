# Copy to .env for local development.
NODE_ENV=development
PORT=3000

# Local docker-compose Postgres
DATABASE_URL=postgres://ldsr:ldsr@localhost:5432/ldsr

# Set to true for managed Postgres reached over the public internet
# (Render external URL). Leave false for local and for Render's internal URL.
DATABASE_SSL=false

# Generate a real one: openssl rand -hex 32
JWT_SECRET=change_me_in_production_please_use_openssl_rand_hex_32
JWT_EXPIRES_IN=1h
