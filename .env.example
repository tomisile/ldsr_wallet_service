# Copy to .env for local development.
NODE_ENV=development
PORT=3000

# Local docker-compose Postgres
DATABASE_URL=postgres://ldsr:ldsr@localhost:5432/ldsr

# Set to true for managed Postgres reached over the public internet
# (Render external URL). Leave false for local and for Render's internal URL.
DATABASE_SSL=false

# Generate a real one: openssl rand -hex 32
JWT_SECRET=use_openssl_rand_hex_32
JWT_EXPIRES_IN=1h

# Seeded administrator (db/seeds).
#
# The seed refuses to run when NODE_ENV is not development and ADMIN_PASSWORD is
# still the value below, so a deployed environment cannot end up with a known
# admin password. The container in docker-compose runs as production to mirror
# the real deployment, so change this before seeding through it.
ADMIN_EMAIL=admin@ldsr.local
ADMIN_PASSWORD=admin_local_password
